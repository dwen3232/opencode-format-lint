{
  "name": "opencode-format-lint",
  "version": "0.1.0",
  "description": "OpenCode plugin that auto-formats and lints files after each agent turn",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "format": "bunx prettier . --write",
    "format:check": "bunx prettier . --check",
    "lint": "bunx eslint .",
    "lint:fix": "bunx eslint . --fix",
    "prepublishOnly": "bun run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "opencode",
    "plugin",
    "format",
    "lint",
    "prettier",
    "eslint"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.4.0",
    "@opencode-ai/sdk": "^1.4.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "jiti": "^2.6.1",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.58.2",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
