{
  "name": "opencode-format-lint",
  "version": "0.1.0",
  "description": "OpenCode plugin that auto-formats and lints files after each agent turn",
  "type": "module",
  "packageManager": "bun@1.3.5",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwen3232/opencode-format-lint.git"
  },
  "homepage": "https://github.com/dwen3232/opencode-format-lint#readme",
  "bugs": {
    "url": "https://github.com/dwen3232/opencode-format-lint/issues"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./codefmt.schema.json": "./dist/codefmt.schema.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun && bun run scripts/generate-json-schema.ts",
    "changeset": "changeset",
    "format": "bunx prettier . --write",
    "format:check": "bunx prettier . --check",
    "lint": "bunx eslint .",
    "lint:fix": "bunx eslint . --fix",
    "prepublishOnly": "bun run build",
    "release": "bun run build && changeset publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "version-packages": "changeset version"
  },
  "keywords": [
    "opencode",
    "plugin",
    "format",
    "lint",
    "prettier",
    "eslint"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@opencode-ai/plugin": "^1.4.0",
    "@opencode-ai/sdk": "^1.4.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "jiti": "^2.6.1",
    "prettier": "^3.8.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.58.2",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
